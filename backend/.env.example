# Server Configuration
PORT=4000
NODE_ENV=development

# CORS Configuration
# Development: http://localhost:3000
# Production: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# WebAuthn/Passkey Configuration
# CRITICAL: RP_ID must match your domain!
# Development: localhost
# Production: yourdomain.com (without protocol, without www)
RP_ID=localhost

# Display name for your passkey (shown in browser dialog)
RP_NAME=Arc Wallet

# Expected origin for WebAuthn
# Development: http://localhost:3000
# Production: https://yourdomain.com (with protocol, match your frontend URL exactly)
ORIGIN=http://localhost:3000

# Database Configuration
DB_PATH=./data/wallet.db

# Security (CHANGE THESE IN PRODUCTION!)
SESSION_SECRET=your-super-secret-session-key-change-this-in-production
JWT_SECRET=your-jwt-secret-key-change-this-in-production

# Database Encryption Key (REQUIRED for production!)
# Generate with: openssl rand -hex 32
DB_ENCRYPTION_KEY=your-database-encryption-key-change-this-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Production Example:
# NODE_ENV=production
# ALLOWED_ORIGINS=https://app.arcwallet.com,https://www.arcwallet.com
# RP_ID=arcwallet.com
# ORIGIN=https://app.arcwallet.com
# SESSION_SECRET=use-a-cryptographically-secure-random-string-here
# JWT_SECRET=another-cryptographically-secure-random-string
# Email / SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM_ADDRESS=magic@arcwallet.network
EMAIL_FROM_NAME=Arc Wallet

# Magic Link Configuration
# CRITICAL: Must match your frontend URL, not backend!
# Development: http://localhost:3000
# Production: https://app.arcwallet.network
MAGIC_LINK_BASE_URL=http://localhost:3000

# RPC URLs
ARC_RPC_URL=https://rpc.testnet.arc.network
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
