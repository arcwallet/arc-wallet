# ArcWallet Backend Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3001
NODE_ENV=production

# ============================================
# DATABASE
# ============================================
DB_PATH=./data/arcwallet.db
DB_ENCRYPTION_KEY=generate_random_encryption_key_min_32_chars

# ============================================
# BLOCKCHAIN CONFIGURATION
# ============================================
ARC_RPC_URL=https://rpc.testnet.arc.network
# IMPORTANT: Set this to your actual EntryPoint contract address
# The default 0x0000... will cause "UNCONFIGURED_NAME" errors
# Get the correct address from your network deployment
ARC_ENTRY_POINT=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789

# ============================================
# MAGIC LINK CONFIGURATION
# ============================================
# For local development: http://localhost:3001
# For production: https://your-backend-domain.com
MAGIC_LINK_BASE_URL=http://localhost:3001

# ============================================
# EMAIL CONFIGURATION (SendGrid)
# ============================================
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Arc Wallet

# ============================================
# OAUTH CONFIGURATION
# ============================================
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Twitter OAuth
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret

# ============================================
# FRONTEND URL
# ============================================
# For local development: http://localhost:3000
# For production: https://your-frontend-domain.com
FRONTEND_URL=http://localhost:3000

# ============================================
# CORS CONFIGURATION
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# ============================================
# SESSION CONFIGURATION
# ============================================
SESSION_SECRET=generate_random_session_secret_min_32_chars
SESSION_MAX_AGE=86400000

# ============================================
# PUSH NOTIFICATIONS (Web Push)
# ============================================
# Generate VAPID keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:your-email@yourdomain.com
