# ArcWallet Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# BLOCKCHAIN CONFIGURATION
# ============================================
VITE_ARC_RPC_URL=https://rpc.testnet.arc.network
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# IMPORTANT: Set this to your actual EntryPoint contract address
# The default 0x0000... will cause "UNCONFIGURED_NAME" errors
# Get the correct address from your network deployment
VITE_ARC_ENTRY_POINT=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789
VITE_EXPLORER_URL=https://testnet.arcscan.app

# ============================================
# BACKEND API CONFIGURATION
# ============================================
# For production deployment:
VITE_BACKEND_URL=https://arcwallet-backend.onrender.com
VITE_PASSKEY_API_URL=https://arcwallet-backend.onrender.com

# For local development with backend on port 4000:
# VITE_BACKEND_URL=http://localhost:4000
# VITE_PASSKEY_API_URL=http://localhost:4000

# ============================================
# CIRCLE API CONFIGURATION
# ============================================
# Get these from https://console.circle.com/wallets/developer
VITE_CIRCLE_API_KEY=your_circle_api_key_here
VITE_CIRCLE_ENTITY_SECRET=your_circle_entity_secret_here

# ============================================
# CIRCLE STABLEFX CONFIGURATION
# ============================================
# StableFX API for USDC ↔ EURC swaps (contact sales@circle.com for access)
VITE_CIRCLE_STABLEFX_API_KEY=your_stablefx_api_key_here
# Set to 'false' for production
VITE_STABLEFX_SANDBOX=true

# ============================================
# SECURITY
# ============================================
# Wallet cache encryption key (min 16 chars, generate random string)
VITE_WALLET_ENCRYPTION_SECRET=generate_random_string_min_16_chars

# ============================================
# ERC-4337 ACCOUNT ABSTRACTION
# ============================================
# Arc uses its own bundler - no external service needed
# Bundler endpoint: /api/bundler/rpc

# ============================================
# ADMIN CONFIGURATION
# ============================================
# Comma-separated list of admin emails for extended timeout (5 min vs 30 sec)
VITE_ADMIN_EMAILS=admin@arcwallet.network,seher@arc.network

# ============================================
# DEBUG CONFIGURATION
# ============================================
VITE_SWAP_DEBUG=false
VITE_BRIDGE_DEBUG=false
