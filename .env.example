# Blockchain RPC URLs
# ThirdWeb RPC Configuration (Recommended)
VITE_THIRDWEB_API_KEY=your_thirdweb_api_key_here
VITE_ARC_RPC_URL=https://5042002.rpc.thirdweb.com/${VITE_THIRDWEB_API_KEY}

# Alternative: Use public RPC (not recommended for production)
# VITE_ARC_RPC_URL=https://rpc.testnet.arc.network

VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Passkey Backend Configuration
# Development: http://localhost:4000
# Production: https://api.arcwallet.network (your backend URL)
VITE_PASSKEY_API_URL=http://localhost:4000

# Optional: ERC-4337 Configuration
VITE_ARC_ENTRY_POINT=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789
VITE_ARC_BUNDLER_URL=https://bundler.testnet.arc.network

# Circle API Configuration for Swap Functionality
# Get these from https://console.circle.com/wallets/developer
VITE_CIRCLE_API_KEY=your_circle_api_key_here
VITE_CIRCLE_ENTITY_SECRET=your_circle_entity_secret_here

# Debug Configuration
VITE_BRIDGE_DEBUG=false
VITE_SWAP_DEBUG=false

# ===================================
# PRODUCTION EXAMPLE (app.arcwallet.network)
# ===================================
# VITE_PASSKEY_API_URL=https://api.arcwallet.network
